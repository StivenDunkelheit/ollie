# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_…) — бывший anon. Безопасен в браузере.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…) — бывший service_role. Обходит RLS.
# Только на сервере, никогда не префиксовать NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Базовый URL приложения (для генерации ссылок ученику)
NEXT_PUBLIC_APP_URL=http://localhost:3000
