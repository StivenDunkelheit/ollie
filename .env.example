# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Publishable key (sb_publishable_…) — бывший anon. Безопасен в браузере.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…) — бывший service_role. Обходит RLS.
# Только на сервере, никогда не префиксовать NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Строка подключения к Postgres — нужна только для `npm run db:migrate`.
# Supabase → Project Settings → Database → Connection string → URI (Session pooler).
# Содержит пароль базы: живёт только в .env.local, в репозиторий не попадает.
SUPABASE_DB_URL=postgresql://postgres.xxxx:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Необязательно. Адрес приложения определяется из самого запроса, поэтому
# ссылка ученику работает и локально, и на продакшене без настройки.
# Задавайте только если приложение стоит за прокси, который не проставляет
# заголовки x-forwarded-host / x-forwarded-proto.
# NEXT_PUBLIC_APP_URL=
